# ─── Supabase (Project Settings → API) ────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The publishable key (sb_publishable_...) — or the legacy "anon" JWT key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# ─── App ──────────────────────────────────────────────────────────────────────
# Canonical origin used in share links + OG images. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://vouch.school

# ─── Scripts only (NEVER expose to the browser, never prefix NEXT_PUBLIC_) ────
# Used by `npm run seed:demo` to create fake students for local testing.
SUPABASE_SECRET_KEY=
